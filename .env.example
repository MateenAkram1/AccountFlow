# === App ===
APP_ENV=development
DATABASE_URL=sqlite:///./data/accountflow.db
CORS_ORIGINS=http://localhost:3000
WEB_APP_URL=http://localhost:3000

# === Auth (session crypto) ===
# Long random string for session JWT signing
JWT_SECRET=change-me-to-a-long-random-string
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_FERNET_KEY=
JWT_EXPIRY_HOURS=8

# LLM / STT defaults for mock demos (user BYOK keys live in Settings UI)
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b

STT_PROVIDER=mock
DEEPGRAM_API_KEY=

# === Integrations ===
# true = simulate Gmail/HubSpot/Jira; false = live APIs (uses each user's vault keys)
INTEGRATIONS_MOCK=true

# Google OAuth app (login + Gmail share one redirect URI — must match Google Console exactly)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Optional legacy env fallbacks (unused when a user is logged in with BYOK vault)
HUBSPOT_ACCESS_TOKEN=
# alias also accepted: HUBSPOT_API_TOKEN
JIRA_SITE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# === Web ===
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_APP_URL=http://localhost:3000

# === Prod (optional) ===
# When both are set, API stores (users/vault/tokens/runs/sows) use Turso instead of local SQLite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Render Dashboard API key (Account Settings → API Keys). Deploy/management only.
RENDER_API_KEY=

# Vercel CLI token (Account Settings → Tokens)
VERCEL_TOKEN=

# Vercel API (production): https://accountflow-api.vercel.app
# Set NEXT_PUBLIC_API_URL to that URL when deploying the web app.
# Add Google OAuth redirect: https://accountflow-api.vercel.app/auth/google/callback
