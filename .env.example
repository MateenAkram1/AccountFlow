# === App ===
APP_ENV=development
DATABASE_URL=sqlite:///./data/accountflow.db
CORS_ORIGINS=http://localhost:3000

# LLM (gemini | ollama_cloud | ollama | mock)
LLM_PROVIDER=mock
GEMINI_API_KEY=
# Ollama Cloud — https://ollama.com (native /api/chat, NOT OpenAI /v1)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
# Aliases also accepted: OLLAMA_CLOUD_API_KEY, OLLAMA_CLOUD_BASE_URL, OLLAMA_CLOUD_MODEL

# STT (default: deepgram; use mock for offline dev/tests)
STT_PROVIDER=mock
DEEPGRAM_API_KEY=

# === Integrations (Phase 6) ===
INTEGRATIONS_MOCK=true
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8000/auth/hubspot/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# === Web (Vercel) ===
NEXT_PUBLIC_API_URL=http://localhost:8000

# === Prod (optional) ===
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
